{
  "appId": "local.waypoint.dm",
  "productName": "Waypoint",
  "directories": {
    "app": "desktop/build",
    "output": "../waypoint-packaged"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "speech-worker.py",
    "data/**/*",
    "renderer/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "signAndEditExecutable": false,
    "icon": "desktop/icons/waypoint.ico"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "artifactName": "Waypoint-Setup-${version}.exe",
    "shortcutName": "Waypoint",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "Waypoint.exe"
  },
  "asar": true,
  "npmRebuild": false,
  "publish": [
    {
      "provider": "github",
      "owner": "munchtech",
      "repo": "waypoint",
      "releaseType": "release"
    }
  ]
}
